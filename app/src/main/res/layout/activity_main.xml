<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@drawable/bg_dark_gradient">

    <LinearLayout
        android:id="@+id/rootLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp"
        android:gravity="center_horizontal">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_marginTop="8dp">

            <TextView
                android:id="@+id/tvStats"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Lvl 1 • 0 XP • 🌲 0 Trees"
                android:textColor="@color/accent_blue"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvStreak"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_glass"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:text="🔥 1 Day Streak"
                android:textColor="@color/warning"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_card_glass"
            android:orientation="vertical"
            android:padding="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvBossIcon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="👹"
                    android:textSize="22sp" />

                <TextView
                    android:id="@+id/tvBossName"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:text="Procrastination Demon"
                    android:textColor="@color/danger"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvBossDefeated"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Slain: 0"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />
            </LinearLayout>

            <ProgressBar
                android:id="@+id/bossHpBar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="8dp"
                android:layout_marginTop="8dp"
                android:max="200"
                android:progress="200"
                android:progressTint="@color/danger" />

            <TextView
                android:id="@+id/tvBossHp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:layout_marginTop="4dp"
                android:text="HP: 200/200"
                android:textColor="@color/danger_soft"
                android:textSize="11sp" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="220dp"
            android:layout_height="220dp"
            android:layout_marginTop="20dp">

            <ProgressBar
                android:id="@+id/timerProgressBar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:indeterminate="false"
                android:max="1500"
                android:progress="1500"
                android:progressDrawable="@drawable/custom_circular_progress" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvTreeEmoji"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🌱"
                    android:textSize="40sp" />

                <TextView
                    android:id="@+id/tvTimer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="25:00"
                    android:textColor="@color/text_primary"
                    android:textSize="36sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvTreeStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Stage 1: Sprout"
                    android:textColor="@color/success"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </FrameLayout>

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:scrollbars="none">

            <RadioGroup
                android:id="@+id/rgSubjects"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/rbSubjectCoding"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_pill_active"
                    android:button="@null"
                    android:checked="true"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="6dp"
                    android:text="💻 Coding"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp" />

                <RadioButton
                    android:id="@+id/rbSubjectMath"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_card_glass"
                    android:button="@null"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="6dp"
                    android:text="📐 Math"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />

                <RadioButton
                    android:id="@+id/rbSubjectDeepWork"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_card_glass"
                    android:button="@null"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="6dp"
                    android:text="⚡ Deep Work"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />
            </RadioGroup>
        </HorizontalScrollView>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Ambient Sound"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:textStyle="bold" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:scrollbars="none">

            <RadioGroup
                android:id="@+id/rgSound"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/rbLofi"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_pill_active"
                    android:button="@null"
                    android:checked="true"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="6dp"
                    android:text="🎧 Lo-Fi"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp" />

                <RadioButton
                    android:id="@+id/rbRain"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_card_glass"
                    android:button="@null"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="6dp"
                    android:text="🌧️ Rain"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />

                <RadioButton
                    android:id="@+id/rbWhiteNoise"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_card_glass"
                    android:button="@null"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="6dp"
                    android:text="📻 White Noise"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />

                <RadioButton
                    android:id="@+id/rbMute"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_card_glass"
                    android:button="@null"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="6dp"
                    android:text="🔇 Mute"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />
            </RadioGroup>
        </HorizontalScrollView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnStart"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:backgroundTint="@color/success"
                android:text="START FOCUS"
                android:textColor="@color/success_dark"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnReset"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:backgroundTint="@color/card_border"
                android:text="GIVE UP"
                android:textColor="@color/danger"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnSetTime"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="PRESETS"
                android:textColor="@color/accent_blue" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnViewHistory"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="🌲 Forest Garden"
                android:textColor="@color/success"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btnStudyBot"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="🤖 AI Study Buddy"
                android:textColor="@color/accent_blue"
                android:textSize="13sp" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>